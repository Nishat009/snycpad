PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/syncpad
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Realtime tuning
PERSIST_DEBOUNCE_MS=1500
PERSIST_MAX_WAIT_MS=10000
# Empty room is unloaded from memory after this many minutes
SESSION_IDLE_MINUTES=5
# A connected user with no activity is disconnected after this many minutes
SOCKET_IDLE_MINUTES=30
# Rooms untouched for this many days are deleted (0 = never)
ROOM_TTL_DAYS=30
